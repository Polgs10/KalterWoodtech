# Google Maps: nombre del lugar, dirección completa o coordenadas (latitud,longitud).
VITE_GOOGLE_MAPS_QUERY="Calle, número, código postal, ciudad, país"

# Pega las URL completas de los perfiles de la empresa.
VITE_FACEBOOK_URL="https://www.facebook.com/tu-pagina"
VITE_INSTAGRAM_URL="https://www.instagram.com/tu-cuenta/"

# Cloudinary: nombre del cloud donde están alojadas las imágenes del sitio.
VITE_CLOUDINARY_CLOUD="tu_cloud_name"

# EmailJS: datos públicos de integración del formulario de contacto.
VITE_EMAILJS_SERVICE="service_xxx"
VITE_EMAILJS_TEMPLATE="template_xxx"
VITE_EMAILJS_KEY="tu_public_key"
